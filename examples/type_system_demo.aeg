// Aegis Type System Demonstration

fn explicit_types() {
    print("=== Explicit Types ===")
    
    // Primitive types
    int port = 80
    float version = 1.0
    bool secure = true
    string host = "localhost"
    byte flag = 0xFF
    
    print("Port: " + to_string(port))
    print("Version: " + to_string(version))
    print("Secure: " + to_string(secure))
    print("Host: " + host)
}

fn type_inference() {
    print("=== Type Inference ===")
    
    // Compiler infers types
    let port = 80           // int
    let version = 1.0       // float
    let secure = true       // bool
    let host = "localhost"  // string
    
    print("Port: " + to_string(port))
    print("Host: " + host)
}

fn collections() {
    print("=== Collections ===")
    
    // Arrays
    array<int> ports = [22, 80, 443, 3306]
    array<string> hosts = ["localhost", "example.com"]
    
    // Type inference for arrays
    let common_ports = [21, 22, 23, 25, 80, 443]
    
    // Maps
    map<string, int> port_map = {
        "ssh": 22,
        "http": 80,
        "https": 443
    }
    
    // Iterate array
    for port in ports {
        print("Scanning port: " + to_string(port))
    }
    
    // Access map
    let ssh_port = port_map["ssh"]
    print("SSH port: " + to_string(ssh_port))
}

fn security_types() {
    print("=== Security Types ===")
    
    // Tainted input
    tainted<string> user_input = input()
    
    // This would trigger warning
    // string query = "SELECT * FROM users WHERE id = " + user_input
    
    // Must sanitize first
    safe<string> clean_input = sanitize(user_input)
    
    // Now safe to use
    string query = "SELECT * FROM users WHERE id = " + clean_input
    
    // Or use parameterized query
    let safe_query = sql("SELECT * FROM users WHERE id = ?", user_input)
}

fn mutable_variables() {
    print("=== Mutable Variables ===")
    
    // Explicit mutable
    int mut counter = 0
    counter = counter + 1
    counter = counter + 1
    print("Counter: " + to_string(counter))
    
    // Inferred mutable
    let mut total = 0
    for i in range(1, 10) {
        total = total + i
    }
    print("Total: " + to_string(total))
}

fn type_conversions() {
    print("=== Type Conversions ===")
    
    // String conversions
    int port = 80
    string port_str = to_string(port)
    
    float version = 1.5
    string version_str = to_string(version)
    
    bool flag = true
    string flag_str = to_string(flag)
    
    // Parse from string
    string input_str = "8080"
    int parsed_port = to_int(input_str)
    
    print("Parsed port: " + to_string(parsed_port))
}

fn main() {
    explicit_types()
    type_inference()
    collections()
    security_types()
    mutable_variables()
    type_conversions()
}
